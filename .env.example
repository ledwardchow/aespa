# Copy to .env and adjust as needed. All variables are optional.
AESPA_DATABASE_URL=sqlite:///./aespa_data/aespa.db
AESPA_HOST=127.0.0.1
AESPA_PORT=8000

# Authentication state is saved under AESPA_DATA_DIR. Optionally read the
# management key from a protected file containing at least 32 characters.
# AESPA_AUTH_KEY_FILE=/run/secrets/aespa_key
# AESPA_ALLOWED_HOSTS=["aespa.example.com"]
# Require HTTPS cookies when using an HTTPS reverse proxy.
# AESPA_AUTH_COOKIE_SECURE=true
# Sign in through Cloudflare Access instead of the key (both required)
# AESPA_CLOUDFLARE_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# AESPA_CLOUDFLARE_ACCESS_AUD=<application audience tag>

# Optional listener for the API extension only. Disabled automatically in Docker.
# AESPA_INTEGRATION_PORT=8001
# AESPA_INTEGRATION_HOST=127.0.0.1

# First-time setup: install Playwright's Chromium browser
#   uv run playwright install chromium
